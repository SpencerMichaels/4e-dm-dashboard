{
  "name": "4e-dm-dashboard",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "authoring": "tsx --tsconfig tsconfig.node.json tools/authoring/cli.ts",
    "test:authoring:ui": "FOUR_E_HIDDEN_WINDOWS=1 electron tools/authoring/smoke-electron.cjs --ozone-platform=wayland --no-sandbox",
    "test:compendium:ui": "FOUR_E_HIDDEN_WINDOWS=1 electron tools/ui-smoke/compendium-smoke.cjs --ozone-platform=wayland --no-sandbox",
    "test:combat:ui": "FOUR_E_HIDDEN_WINDOWS=1 electron tools/ui-smoke/combat-smoke.cjs --ozone-platform=wayland --no-sandbox",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "content:build": "for s in parsed items traps diseases glossary; do tsx --tsconfig tsconfig.node.json tools/content/build-$s.ts || exit 1; done",
    "content:convert": "tsx --tsconfig tsconfig.node.json tools/content/convert/index.ts",
    "content:validate": "tsx --tsconfig tsconfig.node.json tools/content/validate/index.ts",
    "content:agent:sample": "tsx --tsconfig tsconfig.node.json tools/content/agent/sample.ts",
    "content:agent:prompt": "tsx --tsconfig tsconfig.node.json tools/content/agent/prompt.ts",
    "content:agent:apply": "tsx --tsconfig tsconfig.node.json tools/content/agent/apply.ts",
    "content:agent:briefs": "tsx --tsconfig tsconfig.node.json tools/content/agent/briefs.ts",
    "content:agent:apply-all": "tsx --tsconfig tsconfig.node.json tools/content/agent/apply-all.ts"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tiptap/extension-link": "^2.11.0",
    "@tiptap/extension-placeholder": "^2.11.0",
    "@tiptap/pm": "^2.11.0",
    "@tiptap/react": "^2.11.0",
    "@tiptap/starter-kit": "^2.11.0",
    "nanoid": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "^38.0.0",
    "electron-vite": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^4.1.12"
  }
}
