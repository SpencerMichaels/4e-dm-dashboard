{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./out/tsconfig.node",
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@common/*": ["./src/common/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/common/**/*",
    "electron.vite.config.ts",
    "plugins/**/*"
  ]
}
