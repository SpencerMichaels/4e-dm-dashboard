{
  "compilerOptions": {
    "composite": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./out/tsconfig.node",
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@common/*": ["./src/common/*"],
      "@kit": ["./vendor/4e-kit/src/index.ts"],
      "@kit/*": ["./vendor/4e-kit/src/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/common/**/*",
    "vendor/4e-kit/src/**/*",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "tools/**/*",
    "src/renderer/components/creature/monster-templates.ts",
    "src/renderer/components/creature/monster-themes.ts",
    "src/renderer/components/creature/kit-templates.ts",
    "content/parsed/*.json"
  ]
}
